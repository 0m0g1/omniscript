// standard/1/FontData.os
// Embedded 8x16 monospace bitmap font (ASCII 32..126, DejaVu Sans Mono rendered at 13px, 4-bit alpha).
// Generated data; do not edit by hand. buildAtlas() returns a malloc'd 128x128 RGBA atlas:
//   glyph i (char - 32) lives at column (i mod 16) * 8, row (i div 16) * 16;
//   a solid white 8x16 cell sits at x = 0, y = 96 (used for rects, so everything batches on one texture).
// No `return` inside loop bodies.
module CMem = import "standard/1/c/mem.os";

let ATLAS_W: int = 128;
let ATLAS_H: int = 128;
let GLYPH_W: int = 8;
let GLYPH_H: int = 16;
let WHITE_X: int = 0;
let WHITE_Y: int = 96;
let CHUNK_LEN: int = 1520;
function chunk0() => char* { return ""; }
function chunk1() => char* { return ""; }
function chunk2() => char* { return ""; }
function chunk3() => char* { return ""; }
function chunk4() => char* { return ""; }
function chunk5() => char* { return ""; }
function chunk6() => char* { return ""; }
function chunk7() => char* { return ""; }

function chunk(k: int) => char* {
    let r: char* = chunk0();
    if (k == 1) r = chunk1();
    if (k == 2) r = chunk2();
    if (k == 3) r = chunk3();
    if (k == 4) r = chunk4();
    if (k == 5) r = chunk5();
    if (k == 6) r = chunk6();
    if (k == 7) r = chunk7();
    return r;
}

function nibble(c: char) => int {
    let v: int = c as int;
    let r: int = v - 48;
    if (v >= 65) r = v - 55;
    if (v >= 97) r = v - 87;
    return r;
}

// Caller owns the returned buffer (CMem.free).
function buildAtlas() => u8* {
    let px = CMem.malloc((ATLAS_W * ATLAS_H * 4) as u64) as u8*;
    let i: int = 0;
    while (i < ATLAS_W * ATLAS_H) {
        px[i * 4] = 255 as u8; px[i * 4 + 1] = 255 as u8; px[i * 4 + 2] = 255 as u8; px[i * 4 + 3] = 0 as u8;
        i = i + 1;
    }
    let k: int = 0;
    while (k < 8) {
        let s: char* = chunk(k);
        let j: int = 0;
        while (j < CHUNK_LEN) {
            let n: int = k * CHUNK_LEN + j;
            let glyph: int = n / (GLYPH_W * GLYPH_H);
            let within: int = n % (GLYPH_W * GLYPH_H);
            let gx: int = (glyph % 16) * GLYPH_W + within % GLYPH_W;
            let gy: int = (glyph / 16) * GLYPH_H + within / GLYPH_W;
            px[(gy * ATLAS_W + gx) * 4 + 3] = (nibble(s[j]) * 17) as u8;
            j = j + 1;
        }
        k = k + 1;
    }
    let y: int = 0;
    while (y < GLYPH_H) {
        let x: int = 0;
        while (x < GLYPH_W) { px[((WHITE_Y + y) * ATLAS_W + WHITE_X + x) * 4 + 3] = 255 as u8; x = x + 1; }
        y = y + 1;
    }
    return px;
}
