// standard/1/c/net.os  (PLATFORM: WinSock2 via ws2_32.dll; POSIX: drop WSA*, closesocket->close, drop the library string)
extern "C", "ws2_32.dll" fn WSAStartup(ver: u16, data: void*) => int;
extern "C", "ws2_32.dll" fn WSACleanup() => int;
extern "C", "ws2_32.dll" fn WSAGetLastError() => int;
extern "C", "ws2_32.dll" fn socket(af: int, kind: int, proto: int) => u64;
extern "C", "ws2_32.dll" fn closesocket(s: u64) => int;
extern "C", "ws2_32.dll" fn connect(s: u64, addr: void*, len: int) => int;
extern "C", "ws2_32.dll" fn bind(s: u64, addr: void*, len: int) => int;
extern "C", "ws2_32.dll" fn listen(s: u64, backlog: int) => int;
extern "C", "ws2_32.dll" fn accept(s: u64, addr: void*, len: int*) => u64;
extern "C", "ws2_32.dll" fn send(s: u64, buf: void*, len: int, flags: int) => int;
extern "C", "ws2_32.dll" fn recv(s: u64, buf: void*, len: int, flags: int) => int;
extern "C", "ws2_32.dll" fn getaddrinfo(host: char*, port: char*, hints: void*, res: void**) => int;
extern "C", "ws2_32.dll" fn freeaddrinfo(res: void*) => void;
extern "C", "ws2_32.dll" fn shutdown(s: u64, how: int) => int;
extern "C", "ws2_32.dll" fn sendto(s: u64, buf: void*, len: int, flags: int, to: void*, tolen: int) => int;
extern "C", "ws2_32.dll" fn recvfrom(s: u64, buf: void*, len: int, flags: int, src: void*, fromlen: int*) => int;
extern "C", "ws2_32.dll" fn inet_pton(af: int, src: char*, dst: void*) => int;
extern "C", "ws2_32.dll" fn inet_ntop(af: int, src: void*, dst: char*, size: u64) => char*;
