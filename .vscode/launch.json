{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

    "version": "0.2.0",
    "configurations": [
        {
        "name": "DEBUG OPENGL",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/Debug-windows-x86_64/Osengine.exe",
        "args": [
            "examples\\opengl\\triangle.os",
            "--execute",
            "--debug",
            "--optimization-level",
            "-1"
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb"
        },
        {
        "name": "DEBUG JIT",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/Debug-windows-x86_64/Osengine.exe",
        "args": ["examples\\timer.os", "--execute", "--debug", "--optimization-level", "-1"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "logging": {
            "moduleLoad": true,
            "trace": true
        }
        },
        {
        "name": "DEBUG AOT",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/Debug-windows-x86_64/Osengine.exe",
        "args": [
            "examples\\test.os",
            "--make",
            "--o",
            "test.os",
            "--debug",
            "--optimization-level",
            "-1"
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb"
        }
    ]
}
